APP_NAME=Apps POS API
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://pos:pos@postgres:5432/pos
REDIS_URL=redis://redis:6379/0

# WAJIB diganti sebelum produksi - generate dgn `openssl rand -hex 32`.
JWT_SECRET=ubah-secret-ini-sebelum-produksi
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

OTP_EXPIRE_SECONDS=300
# mock = log ke stdout, tidak kirim sungguhan (dev/test). Provider
# WhatsApp/SMS asli belum diimplementasikan - lihat app/services/otp_service.py.
OTP_PROVIDER=mock

PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_API_KEY=

S3_BUCKET=
S3_REGION=ap-southeast-3
S3_ENDPOINT_URL=
